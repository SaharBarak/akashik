{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folklore",
  "version": "0.1.2",
  "identifier": "sh.usefolklore.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Folklore",
        "width": 560,
        "height": 640,
        "resizable": false,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "island",
        "title": "Folklore Activity",
        "url": "island.html",
        "width": 460,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "resources": {
      "resources/node": "node"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Peer-to-peer memory for your AI coding agents.",
    "longDescription": "Folklore wires a local, signed knowledge graph into every AI coding tool on your machine \u2014 Claude Code, Cursor, Cline, Windsurf, Gemini CLI, Zed, opencode, Roo. Answers come from your own research and your peers before the web. Download installs everything; no command needed."
  }
}
